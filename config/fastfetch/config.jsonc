{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1       /\\\n$2      /  \\\n$3     /\\   \\\n$4    /      \\\n$5   /   ,,   \\\n$6  /   |  |  -\\\n$7 /_-''    ''-_\\",
    "color": {
      "1": "#debcdf",
      "2": "#d4bfde",
      "3": "#c9c3dd",
      "4": "#bfc6dc",
      "5": "#b9c6e8",
      "6": "#b3c6f3",
      "7": "#adc6ff"
    },
    "padding": {
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "type": "string",
      "width": 0
    },
    "color": {
      "keys": "#adc6ff",
      "title": "#debcdf",
      "output": "#8e9099",
      "separator": "#adc6ff"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#debcdf",
        "at": "#8e9099",
        "host": "#debcdf"
      }
    },
    {
      "type": "separator",
      "string": "\u2500",
      "outputColor": "#8e9099"
    },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "wm",
      "key": "WM"
    },
    "terminal"
  ]
}