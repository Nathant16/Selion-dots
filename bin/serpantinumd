#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$SERPANTINUM_DIR" ]; then
    export SERPANTINUM_DIR="$(dirname "$BIN_DIR")/src"
fi

source "$SERPANTINUM_DIR/scripts/daemon_lock.sh"
daemon_init_paths
source "$SERPANTINUM_DIR/scripts/caching.sh"
source "$SERPANTINUM_DIR/scripts/config.sh"
source "$SERPANTINUM_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    export MAIN_QML="$(find "$SERPANTINUM_DIR/quickshell" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
fi

is_alive() {
    daemon_is_alive "$@"
}

terminate_and_wait() {
    daemon_terminate_and_wait "$@"
}

get_all_children() {
    local target="$1"
    local child
    for child in $(pgrep -P "$target" 2>/dev/null); do
        get_all_children "$child"
        echo "$child"
    done
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^SERPANTINUM_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$SERPANTINUM_VERSION" ]; then
        ver="$SERPANTINUM_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$SERPANTINUM_DIR" ] && [ -f "$SERPANTINUM_DIR/version.txt" ]; then
            ver=$(cat "$SERPANTINUM_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$SERPANTINUM_DIR" ] && [ -f "$(dirname "$SERPANTINUM_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$SERPANTINUM_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

show_help() {
    echo "$(t "daemon.cli.usage")"
    echo ""
    echo "$(t "daemon.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  start                       $(t "daemon.cli.cmd_start")"
    echo "  stop                        $(t "daemon.cli.cmd_stop")"
    echo "  status                      $(t "daemon.cli.cmd_status")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -v, --verbose               $(t "daemon.cli.opt_verbose")"
    echo "  -V, --version               $(t "daemon.cli.opt_version")"
    echo "  -h, --help                  $(t "daemon.cli.opt_help")"
    echo ""
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export SERPANTINUM_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "serpantinumd v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|status|restart)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
            fi
            shift
            ;;
        *)
            echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    COMMAND="start"
fi

if [ "$COMMAND" == "restart" ]; then
    "$0" stop >/dev/null 2>&1 || true
    setsid "$0" start >/dev/null 2>&1 < /dev/null &
    sleep 0.5
    exit 0
fi

if [ "$COMMAND" == "stop" ]; then
    daemon_stop_scoped
    pkill -TERM -u "$DAEMON_UID" -f "wl-paste --watch echo 1" 2>/dev/null || true
    bash "$SERPANTINUM_DIR/scripts/gamma.sh" stop >/dev/null 2>&1 || true
    command -v serpantinum-core >/dev/null 2>&1 && serpantinum-core quit >/dev/null 2>&1 || true
    command -v serpantinum-audio >/dev/null 2>&1 && serpantinum-audio ctl quit >/dev/null 2>&1 || true

    wait_lock_count=0
    while [ "$wait_lock_count" -lt 20 ]; do
        if ( exec 9>"$DAEMON_LOCK_FILE" && flock -n 9 ) 2>/dev/null; then
            break
        fi
        sleep 0.05
        wait_lock_count=$((wait_lock_count + 1))
    done
    echo "$(t "daemon.cli.stopped")"
    exit 0
fi

if [ "$COMMAND" == "status" ]; then
    pid=""
    if [ -f "$DAEMON_PID_FILE" ]; then
        pid="$(cat "$DAEMON_PID_FILE" 2>/dev/null)"
    elif [ -z "${SERPANTINUM_RUNTIME_DIR:-}" ] && [ -f "$LEGACY_DAEMON_PID_FILE" ]; then
        pid="$(cat "$LEGACY_DAEMON_PID_FILE" 2>/dev/null)"
        [ -n "$pid" ] && daemon_proc_matches_scope "$pid" || pid=""
    fi
    if [ -n "$pid" ] && is_alive "$pid"; then
        echo "$(t "daemon.cli.status_running" PID="$pid")"
        exit 0
    else
        echo "$(t "daemon.cli.status_stopped")"
        exit 1
    fi
fi

# Hardware decoder for video wallpapers when the NVIDIA driver is loaded.
# FFmpeg's VAAPI (as used by Qt) opens the FIRST render node, so VAAPI is only
# chosen when that node belongs to another GPU (hybrid laptops: decode on the
# iGPU and let the NVIDIA GPU sleep). Otherwise decode on the CPU.
wallpaper_decoder() {
    local drm="${1:-/sys/class/drm}" node
    for node in "$drm"/renderD*; do
        [ -r "$node/device/vendor" ] || continue
        if [ "$(cat "$node/device/vendor")" != "0x10de" ]; then
            echo vaapi
        else
            echo none
        fi
        return
    done
    echo none
}

if [ "$COMMAND" == "start" ]; then
    exec 9>"$DAEMON_LOCK_FILE"

    if ! flock -n 9; then
        existing_pid=""
        pid_wait=0
        while [ "$pid_wait" -lt 10 ]; do
            [ -f "$DAEMON_PID_FILE" ] && existing_pid="$(cat "$DAEMON_PID_FILE" 2>/dev/null)"
            if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
                break
            fi
            sleep 0.05
            pid_wait=$((pid_wait + 1))
        done

        if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
            if daemon_session_matches_display "$existing_pid"; then
                echo "$(t "daemon.already_running")"
                exit 1
            fi
            terminate_and_wait "$existing_pid" 2
            daemon_cleanup_stray_duplicates
        fi

        lock_wait=0
        acquired=false
        while [ "$lock_wait" -lt 20 ]; do
            if flock -n 9; then
                acquired=true
                break
            fi
            sleep 0.05
            lock_wait=$((lock_wait + 1))
        done

        if [ "$acquired" != true ]; then
            echo "$(t "daemon.already_running")"
            exit 1
        fi
    fi

    printf '%s\n' "$$" > "$DAEMON_PID_FILE"

    CLEANUP_DONE=false
    LAUNCH_PID=""
    QS_PID=""

    cleanup() {
        if [ "$CLEANUP_DONE" = true ]; then
            return
        fi
        CLEANUP_DONE=true
        trap '' SIGINT SIGTERM SIGHUP

        [ "$VERBOSE" = true ] && echo "$(t "daemon.shutting_down")"

        local group
        for group in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$group" ] && kill -TERM -- "-$group" 2>/dev/null
        done
        daemon_kill_matching_group screentime TERM

        local count=0
        while [ "$count" -lt 20 ]; do
            if ! is_alive "$QS_PID" && ! is_alive "$LAUNCH_PID"; then
                break
            fi
            sleep 0.05
            count=$((count + 1))
        done

        for group in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$group" ] && kill -KILL -- "-$group" 2>/dev/null
        done
        daemon_kill_matching_group screentime KILL
        bash "$SERPANTINUM_DIR/scripts/gamma.sh" stop 9>&- >/dev/null 2>&1
        command -v serpantinum-core >/dev/null 2>&1 && serpantinum-core quit 9>&- >/dev/null 2>&1
        command -v serpantinum-audio >/dev/null 2>&1 && serpantinum-audio ctl quit 9>&- >/dev/null 2>&1

        exec 9>&- 2>/dev/null
        if [ "$(cat "$DAEMON_PID_FILE" 2>/dev/null)" = "$$" ]; then
            rm -f "$DAEMON_PID_FILE" 2>/dev/null
        fi
        exit 0
    }

    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    # Clear any orphaned/legacy instances from upgrades before launching our single shell
    daemon_cleanup_stray_duplicates 9>&-

    [ "$VERBOSE" = true ] && echo "$(t "daemon.launching")"

    # Hyprland moved IPC sockets to $XDG_RUNTIME_DIR/hypr; ensure /tmp/hypr compatibility symlink
    if [ -n "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR/hypr" ] && [ ! -e "/tmp/hypr" ]; then
        ln -sf "$XDG_RUNTIME_DIR/hypr" /tmp/hypr 2>/dev/null || true
    fi

    # Ensure state compatibility symlinks for focustime across quickshell, serpantinum, and share
    mkdir -p "$HOME/.local/state/quickshell/focustime" "$HOME/.local/state/serpantinum" "$HOME/.local/share" 2>/dev/null || true
    if [ -f "$HOME/.local/state/serpantinum/focustime/focustime.db" ] && [ ! -s "$HOME/.local/state/quickshell/focustime/focustime.db" ]; then
        mkdir -p "$HOME/.local/state/quickshell/focustime" 2>/dev/null || true
        cp -a "$HOME/.local/state/serpantinum/focustime"/* "$HOME/.local/state/quickshell/focustime/" 2>/dev/null || true
    fi
    if [ ! -L "$HOME/.local/state/serpantinum/focustime" ]; then
        if [ ! -e "$HOME/.local/state/serpantinum/focustime" ] || [ ! -s "$HOME/.local/state/serpantinum/focustime/focustime.db" ]; then
            rm -rf "$HOME/.local/state/serpantinum/focustime" 2>/dev/null || true
            ln -sf "$HOME/.local/state/quickshell/focustime" "$HOME/.local/state/serpantinum/focustime" 2>/dev/null || true
        fi
    fi
    if [ ! -L "$HOME/.local/share/focustime" ]; then
        if [ ! -e "$HOME/.local/share/focustime" ] || [ ! -s "$HOME/.local/share/focustime/focustime.db" ]; then
            rm -rf "$HOME/.local/share/focustime" 2>/dev/null || true
            ln -sf "$HOME/.local/state/quickshell/focustime" "$HOME/.local/share/focustime" 2>/dev/null || true
        fi
    fi

    # Ensure serpantinum-core daemon is running
    command -v serpantinum-core >/dev/null 2>&1 && serpantinum-core start 9>&- >/dev/null 2>&1

    # Apply saved power optimizations on startup
    if [ -f "$SERPANTINUM_DIR/scripts/system/battery" ]; then
        python3 "$SERPANTINUM_DIR/scripts/system/battery" apply-opts 9>&- >/dev/null 2>&1 &
    fi

    (
        bash "$SERPANTINUM_DIR/scripts/migrate_niri_overview.sh"
        bash "$SERPANTINUM_DIR/scripts/migrate_easyeffects.sh"
        [ -f "$SERPANTINUM_DIR/scripts/system/gpu_env.py" ] && python3 "$SERPANTINUM_DIR/scripts/system/gpu_env.py" --apply
        command -v serpantinum-audio >/dev/null 2>&1 && serpantinum-audio start
    ) 9>&- >/dev/null 2>&1 &

    setsid bash "$SERPANTINUM_DIR/quickshell/guide/wellbeing/launch_daemon.sh" 9>&- &
    LAUNCH_PID=$!

    # Auto-detect compositor sockets if not already in environment
    export XCURSOR_THEME="Windows-11M-Dark"
    export XCURSOR_SIZE="32"
    export HYPRCURSOR_THEME="Windows-11M-Dark"
    export HYPRCURSOR_SIZE="32"

    mkdir -p "$HOME/.config/environment.d" 2>/dev/null || true
    cat << 'EOF' > "$HOME/.config/environment.d/10-cursor.conf"
XCURSOR_THEME=Windows-11M-Dark
XCURSOR_SIZE=32
HYPRCURSOR_THEME=Windows-11M-Dark
HYPRCURSOR_SIZE=32
EOF
    systemctl --user import-environment XCURSOR_SIZE XCURSOR_THEME HYPRCURSOR_SIZE HYPRCURSOR_THEME 9>&- 2>/dev/null || true
    hash dbus-update-activation-environment 2>/dev/null && dbus-update-activation-environment --systemd XCURSOR_SIZE XCURSOR_THEME HYPRCURSOR_SIZE HYPRCURSOR_THEME 9>&- 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-theme 'Windows-11M-Dark' 9>&- 2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-size 32 9>&- 2>/dev/null || true
    local_rdir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local_sess="${XDG_SESSION_DESKTOP,,} ${DESKTOP_SESSION,,}"
    active_wm=""
    case "$local_sess" in
        *drift*) active_wm="driftwm" ;;
        *umbriel*) active_wm="umbriel" ;;
        *mango*) active_wm="mango" ;;
        *sway*) active_wm="sway" ;;
        *niri*) active_wm="niri" ;;
        *hypr*) active_wm="hyprland" ;;
    esac
    if [ -z "$active_wm" ]; then
        if pgrep -x driftwm >/dev/null 2>&1; then active_wm="driftwm"
        elif pgrep -x umbriel >/dev/null 2>&1; then active_wm="umbriel"
        elif pgrep -x mango >/dev/null 2>&1; then active_wm="mango"
        elif pgrep -x sway >/dev/null 2>&1; then active_wm="sway"
        elif pgrep -x niri >/dev/null 2>&1; then active_wm="niri"
        elif pgrep -x Hyprland >/dev/null 2>&1; then active_wm="hyprland"
        fi
    fi

    # Drop any leaked compositor socket variables belonging to previous sessions
    case "$active_wm" in
        driftwm)
            unset HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK NIRI_SOCKET MANGO_INSTANCE_SIGNATURE UMBRIEL_SOCKET
            if [ -z "$DRIFTWM_SOCKET" ] && [ -d "$local_rdir/driftwm" ]; then
                local_ds=$(find "$local_rdir/driftwm" -name "ipc-*.sock" 2>/dev/null | head -n 1)
                [ -n "$local_ds" ] && export DRIFTWM_SOCKET="$local_ds"
            fi
            export XDG_CURRENT_DESKTOP="driftwm"
            ;;
        umbriel)
            unset HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK NIRI_SOCKET MANGO_INSTANCE_SIGNATURE DRIFTWM_SOCKET
            if [ -z "$UMBRIEL_SOCKET" ]; then
                local_us=$(ls -t "$local_rdir"/umbriel-*.sock 2>/dev/null | head -n 1)
                [ -n "$local_us" ] && export UMBRIEL_SOCKET="$local_us"
            fi
            export XDG_CURRENT_DESKTOP="Umbriel"
            ;;
        niri)
            unset HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK MANGO_INSTANCE_SIGNATURE UMBRIEL_SOCKET DRIFTWM_SOCKET
            if [ -z "$NIRI_SOCKET" ]; then
                local_ns=$(ls -t "$local_rdir"/niri*.sock 2>/dev/null | head -n 1)
                [ -n "$local_ns" ] && export NIRI_SOCKET="$local_ns"
            fi
            export XDG_CURRENT_DESKTOP="niri"
            ;;
        sway)
            unset HYPRLAND_INSTANCE_SIGNATURE NIRI_SOCKET MANGO_INSTANCE_SIGNATURE UMBRIEL_SOCKET DRIFTWM_SOCKET
            if [ -z "$SWAYSOCK" ]; then
                local_ss=$(ls -t "$local_rdir"/sway-ipc.*.sock 2>/dev/null | head -n 1)
                [ -n "$local_ss" ] && export SWAYSOCK="$local_ss"
            fi
            export XDG_CURRENT_DESKTOP="sway"
            ;;
        mango)
            unset HYPRLAND_INSTANCE_SIGNATURE SWAYSOCK NIRI_SOCKET UMBRIEL_SOCKET DRIFTWM_SOCKET
            if [ -z "$MANGO_INSTANCE_SIGNATURE" ]; then
                local_ms=$(ls -t "$local_rdir"/mango-*.sock 2>/dev/null | head -n 1)
                [ -n "$local_ms" ] && export MANGO_INSTANCE_SIGNATURE="$local_ms"
            fi
            export XDG_CURRENT_DESKTOP="mango"
            ;;
        hyprland)
            unset SWAYSOCK NIRI_SOCKET MANGO_INSTANCE_SIGNATURE UMBRIEL_SOCKET DRIFTWM_SOCKET
            if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ] && [ -d "$local_rdir/hypr" ]; then
                local_hs=$(ls -dt "$local_rdir/hypr"/* 2>/dev/null | head -n 1)
                [ -n "$local_hs" ] && export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$local_hs")"
            fi
            export XDG_CURRENT_DESKTOP="Hyprland"
            ;;
    esac

    # On NVIDIA, keep wallpaper video decoding off the NVIDIA GPU: NVDEC keeps it at
    # full clocks (~+8 W measured on a 1080p loop). Users can still override the variable.
    if [ -d /proc/driver/nvidia ]; then
        export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES-$(wallpaper_decoder)}"
    fi
    setsid quickshell -p "$MAIN_QML" 9>&- &
    QS_PID=$!

    while kill -0 "$QS_PID" 2>/dev/null; do
        wait "$QS_PID" 2>/dev/null
    done
fi
