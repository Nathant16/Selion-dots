{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1       /\\\n$1      /  \\\n$3     /\\   \\\n$3    /      \\\n$2   /   ,,   \\\n$2  /   |  |  -\\\n$2 /_-''    ''-_\\",
    "color": {
      "1": "{{colors.tertiary.default.hex}}",
      "2": "{{colors.primary.default.hex}}",
      "3": "{{colors.secondary.default.hex}}"
    },
    "padding": {
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": ": ",
    "key": {
      "type": "string",
      "width": 0
    },
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.tertiary.default.hex}}",
      "output": "{{colors.outline.default.hex}}",
      "separator": "{{colors.primary.default.hex}}"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "{{colors.tertiary.default.hex}}",
        "at": "{{colors.outline.default.hex}}",
        "host": "{{colors.tertiary.default.hex}}"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "{{colors.outline.default.hex}}"
    },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "wm",
      "key": "WM"
    },
    "terminal"
  ]
}
