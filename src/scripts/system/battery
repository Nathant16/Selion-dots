def set_optimization(opt_id, enabled):
    saved = load_opts_config()
    saved[opt_id] = bool(enabled)
    save_opts_config(saved)

    # Only apply to hardware if currently in power-saver
    platform_profile = get_current_profile()
    if platform_profile in ("low-power", "power-saver"):
        apply_single_opt(opt_id, bool(enabled))
    return get_optimizations_list()

def apply_all_optimizations():
    # Only apply if in power-saver
    platform_profile = get_current_profile()
    if platform_profile not in ("low-power", "power-saver"):
        return False

    saved = load_opts_config()
    for opt_id, val in saved.items():
        if opt_id not in ("cpu_max_freq", "cpu_freq_mode", "auto_brightness", "power_saver_brightness", "pre_saver_brightness"):
            apply_single_opt(opt_id, bool(val))
    cpu_mode = saved.get("cpu_freq_mode", "auto")
    target_khz = int(saved.get("cpu_max_freq", 0))
    if cpu_mode == "manual" and target_khz > 0:
        set_cpu_freq_limit(target_khz)
    else:
        for p in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
            max_f = read_val(os.path.join(p, "cpuinfo_max_freq"), "")
            if max_f:
                write_val(os.path.join(p, "scaling_max_freq"), max_f)
    if saved.get("auto_brightness", True):
        cur_b = get_brightness()
        existing_pre = saved.get("pre_saver_brightness", 0)
        if not existing_pre or int(existing_pre) <= 0:
            saved["pre_saver_brightness"] = cur_b
            save_opts_config(saved)
        target_b = int(saved.get("power_saver_brightness", 80))
        start_fade_brightness_bg(target_b, duration=5.0)
    return True

def main():
    if len(sys.argv) < 2:
        show_status()
        return

    arg = sys.argv[1].lower()
    if arg in ("json", "--json", "-j"):
        data = get_json_data()
        data["optimizations"] = get_optimizations_list()
        print(json.dumps(data))
    elif arg in ("opts", "optimizations", "get-opts"):
        print(json.dumps(get_optimizations_list(), indent=2))
    elif arg in ("set-opt", "opt"):
        if len(sys.argv) > 3:
            opt_id = sys.argv[2]
            val = sys.argv[3].lower() in ("true", "1", "on", "yes", "enable")
            res = set_optimization(opt_id, val)
            print(json.dumps({"success": True, "optimizations": res}))
        else:
            print("Usage: battery set-opt <id> <true|false>")
    elif arg in ("set-freq-mode", "freq-mode"):
        if len(sys.argv) > 2:
            mode = sys.argv[2].lower()
            set_cpu_freq_mode(mode)
            print(json.dumps({"success": True, "cpu_freq": get_cpu_freq_info()}))
        else:
            print("Usage: battery set-freq-mode <auto|manual>")
    elif arg in ("set-freq", "freq", "limit-freq"):
        if len(sys.argv) > 2:
            target = sys.argv[2].lower()
            if target in ("0", "auto", "max", "uncap", "none", "off"):
                set_cpu_freq_mode("auto")
            else:
                try:
                    val = int(target)
                except ValueError:
                    val = 0
                set_cpu_freq_limit(val)
            print(json.dumps({"success": True, "cpu_freq": get_cpu_freq_info()}))
        else:
            print("Usage: battery set-freq <khz|auto>")
    elif arg in ("set-auto-brightness", "auto-brightness"):
        if len(sys.argv) > 2:
            val = sys.argv[2].lower() in ("true", "1", "on", "yes", "enable")
            set_auto_brightness(val)
            print(json.dumps({"success": True, "auto_brightness": val}))
        else:
            print("Usage: battery set-auto-brightness <true|false>")
    elif arg in ("set-saver-brightness", "saver-brightness"):
        if len(sys.argv) > 2:
            set_saver_brightness(sys.argv[2])
            print(json.dumps({"success": True, "power_saver_brightness": int(sys.argv[2])}))
        else:
            print("Usage: battery set-saver-brightness <50-95>")
    elif arg in ("apply-opts", "apply-optimizations"):
        apply_all_optimizations()
        print("✔ Applied power optimizations from config.")
    elif arg in ("fade-brightness", "fade_brightness"):
        target = 80
        dur = 5.0
        if len(sys.argv) > 2:
            try:
                target = int(sys.argv[2])
            except ValueError:
                pass
        if len(sys.argv) > 3:
            try:
                dur = float(sys.argv[3])
            except ValueError:
                pass
        fade_brightness_worker(target, dur)
    elif arg in ("apply-profile-hooks", "profile-hooks", "hook"):
        prof = sys.argv[2].lower() if len(sys.argv) > 2 else get_current_profile()
        if not should_skip_hook(prof):
            apply_profile_optimizations(prof)
        print(f"✔ Hooks applied for profile: {prof}")
    elif arg in ("status", "show", "info", "-s"):
        if len(sys.argv) > 2 and sys.argv[2].lower() in ("json", "--json"):
            print(json.dumps(get_json_data()))
        else:
            show_status()
    elif arg in ("save", "power-saver", "eco"):
        set_profile("power-saver")
    elif arg in ("bal", "balanced", "normal"):
        set_profile("balanced")
    elif arg in ("perf", "performance", "max"):
        set_profile("performance")
    elif arg in ("profile", "set-profile"):
        if len(sys.argv) > 2:
            set_profile(sys.argv[2].lower())
        else:
            print("Использование: battery profile [power-saver | balanced | performance]")
    elif arg in ("limit", "threshold", "cap", "set-limit"):
        if len(sys.argv) > 2:
            set_limit(sys.argv[2])
        else:
            print("Использование: battery limit [80 | 100 | <процент>]")
    elif arg in ("watch", "top"):
        try:
            while True:
                os.system("clear")
                show_status()
                time.sleep(2)
        except KeyboardInterrupt:
            pass
    elif arg in ("help", "-h", "--help"):
        print("ThinkPad Battery Manager")
        print("Использование:")
        print("  battery               - текущий статус и потребление ватт")
        print("  battery json          - статус в формате JSON (для GUI и скриптов)")
        print("  battery save          - включить экономный режим (power-saver)")
        print("  battery bal           - сбалансированный режим (balanced)")
        print("  battery perf          - режим максимальной мощности (performance)")
        print("  battery limit 80      - продление жизни батареи (зарядка до 80%)")
        print("  battery limit 100     - полная зарядка (100% для поездок)")
        print("  battery watch         - мониторинг расхода в реальном времени")
    else:
        print(f"Неизвестная команда: {arg}. Запустите 'battery help' для справки.")

