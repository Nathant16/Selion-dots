#!/usr/bin/env python3
import sys
import os
import glob
import time
import subprocess
import json
import shutil
import math
import signal

def read_val(path, default=""):
    try:
        with open(path, "r") as f:
            return f.read().strip()
    except Exception:
        return default

def write_val(path, val):
    try:
        with open(path, "w") as f:
            f.write(str(val) + "\n")
        return True
    except Exception:
        try:
            res = subprocess.run(["sudo", "-n", "tee", path], input=f"{val}\n", capture_output=True, text=True, timeout=1.5)
            return res.returncode == 0
        except Exception:
            return False

def get_battery_dir():
    candidates = sorted(glob.glob("/sys/class/power_supply/BAT*"))
    if candidates:
        return candidates[0]
    for p in glob.glob("/sys/class/power_supply/*"):
        if read_val(os.path.join(p, "type")).lower() == "battery":
            return p
    return None

def get_battery_info():
    bat_dir = get_battery_dir()
    if not bat_dir:
        return {}
    uevent_path = os.path.join(bat_dir, "uevent")
    info = {}
    if os.path.exists(uevent_path):
        with open(uevent_path, "r") as f:
            for line in f:
                if "=" in line:
                    k, v = line.strip().split("=", 1)
                    info[k] = v
    return info

def format_time(seconds):
    if seconds <= 0 or seconds > 86400 * 2:
        return "N/A"
    h = int(seconds // 3600)
    m = int((seconds % 3600) // 60)
    return f"{h}h {m:02d}m"

def get_json_data():
    bat_dir = get_battery_dir()
    b = get_battery_info()
    has_bat = bool(b and bat_dir and os.path.exists(bat_dir))

    platform_profile = read_val("/sys/firmware/acpi/platform_profile", "")
    if not platform_profile or platform_profile == "unknown":
        try:
            res = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=1)
            if res.returncode == 0:
                platform_profile = res.stdout.strip()
        except Exception:
            platform_profile = "balanced"

    governor = read_val("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor", "powersave")
    boost = read_val("/sys/devices/system/cpu/cpufreq/boost", "1") != "0"
    dpm_files = glob.glob("/sys/class/drm/card*/device/power_dpm_force_performance_level")
    gpu_dpm = read_val(dpm_files[0], "auto") if dpm_files else "auto"

    bl_dirs = glob.glob("/sys/class/backlight/*")
    if bl_dirs:
        bl_act = read_val(f"{bl_dirs[0]}/actual_brightness", "0")
        bl_max = read_val(f"{bl_dirs[0]}/max_brightness", "65535")
        bl_pct = int(float(bl_act) / float(bl_max) * 100) if bl_max and float(bl_max) > 0 else 0
    else:
        bl_pct = 100

    start_file = os.path.join(bat_dir, "charge_control_start_threshold") if bat_dir else ""
    end_file = os.path.join(bat_dir, "charge_control_end_threshold") if bat_dir else ""
    has_threshold_support = bool(end_file and os.path.exists(end_file))
    try:
        th_start = int(read_val(start_file, "0")) if has_threshold_support else 0
    except ValueError:
        th_start = 0
    try:
        th_end = int(read_val(end_file, "100")) if has_threshold_support else 100
    except ValueError:
        th_end = 100
    is_conservation = (th_end < 100)

    if not has_bat:
        return {
            "has_battery": False,
            "capacity": 0,
            "status": "AC",
            "power_w": 0.0,
            "time_str": "",
            "time_seconds": 0,
            "profile": platform_profile,
            "governor": governor,
            "boost": boost,
            "gpu_dpm": gpu_dpm,
            "brightness": bl_pct,
            "threshold_start": 0,
            "threshold_end": 100,
            "is_conservation_mode": False,
            "health_pct": 100.0,
            "energy_now_wh": 0.0,
            "energy_full_wh": 0.0,
            "energy_design_wh": 0.0,
            "cycles": 0,
            "has_threshold_support": False,
            "cpu_freq": get_cpu_freq_info(),
            "auto_brightness": bool(load_opts_config().get("auto_brightness", True)),
            "power_saver_brightness": int(load_opts_config().get("power_saver_brightness", 80))
        }

    status = b.get("POWER_SUPPLY_STATUS", "Unknown")
    try:
        capacity = int(b.get("POWER_SUPPLY_CAPACITY", "0"))
    except ValueError:
        capacity = 0

    energy_now_uw = float(b.get("POWER_SUPPLY_ENERGY_NOW", "0"))
    energy_full_uw = float(b.get("POWER_SUPPLY_ENERGY_FULL", "0"))
    energy_design_uw = float(b.get("POWER_SUPPLY_ENERGY_FULL_DESIGN", "0"))
    power_now_uw = float(b.get("POWER_SUPPLY_POWER_NOW", "0"))

    energy_now_wh = energy_now_uw / 1e6
    energy_full_wh = energy_full_uw / 1e6
    energy_design_wh = energy_design_uw / 1e6
    power_now_w = power_now_uw / 1e6

    time_str = ""
    time_seconds = 0
    if status == "Discharging" and power_now_w > 0.1:
        hours = energy_now_wh / power_now_w
        time_seconds = int(hours * 3600)
        time_str = f"~{format_time(time_seconds)} remaining"
    elif status == "Charging" and power_now_w > 0.1:
        hours = (energy_full_wh - energy_now_wh) / power_now_w
        time_seconds = int(hours * 3600)
        time_str = f"~{format_time(time_seconds)} until full"
    elif status == "Full":
        time_str = "Fully charged"
    else:
        time_str = "AC Connected"

    health_pct = round((energy_full_wh / energy_design_wh * 100.0) if energy_design_wh > 0 else 100.0, 1)
    cycles = b.get("POWER_SUPPLY_CYCLE_COUNT", "0")
    try:
        cycles = int(cycles)
    except Exception:
        cycles = 0

    return {
        "has_battery": True,
        "capacity": capacity,
        "status": status,
        "power_w": round(power_now_w, 2),
        "time_str": time_str,
        "time_seconds": time_seconds,
        "profile": platform_profile,
        "governor": governor,
        "boost": boost,
        "gpu_dpm": gpu_dpm,
        "brightness": bl_pct,
        "threshold_start": th_start,
        "threshold_end": th_end,
        "is_conservation_mode": is_conservation,
        "health_pct": health_pct,
        "energy_now_wh": round(energy_now_wh, 2),
        "energy_full_wh": round(energy_full_wh, 2),
        "energy_design_wh": round(energy_design_wh, 2),
        "cycles": cycles,
        "has_threshold_support": has_threshold_support,
        "cpu_freq": get_cpu_freq_info(),
        "auto_brightness": bool(load_opts_config().get("auto_brightness", True)),
        "power_saver_brightness": int(load_opts_config().get("power_saver_brightness", 80))
    }

def show_status():
    d = get_json_data()
    if not d["has_battery"]:
        print("\033[1;33mВнимание: батарея не найдена (ПК или питание от сети).\033[0m")
        print(f"Текущий профиль питания: \033[1;32m{d['profile']}\033[0m (Gov: {d['governor']})")
        return

    capacity = d["capacity"]
    status = d["status"]
    power_now_w = d["power_w"]
    time_str = d["time_str"]
    platform_profile = d["profile"]
    governor = d["governor"]
    boost_state = "ВКЛ" if d["boost"] else "ВЫКЛ"
    gpu_dpm = d["gpu_dpm"]
    bl_pct = d["brightness"]
    th_start = d["threshold_start"]
    th_end = d["threshold_end"]
    health_pct = d["health_pct"]
    energy_full_wh = d["energy_full_wh"]
    energy_design_wh = d["energy_design_wh"]
    cycles = d["cycles"]

    bar_len = 24
    filled = int(capacity / 100.0 * bar_len)
    
    if capacity > 50:
        bar_color = "\033[38;2;112;212;148m"
    elif capacity > 20:
        bar_color = "\033[38;2;232;194;102m"
    else:
        bar_color = "\033[38;2;242;115;115m"
    
    bar = bar_color + "█" * filled + "\033[38;2;80;80;90m" + "░" * (bar_len - filled) + "\033[0m"

    if status == "Charging":
        icon = "⚡"
    elif status == "Discharging":
        icon = "🔋"
    else:
        icon = "🔌"

    threshold_desc = f"Стоп: {th_end}% (Старт: {th_start}%)"
    if th_end == 80:
        threshold_desc += " \033[1;32m[Режим продления жизни батареи]\033[0m"
    elif th_end == 100:
        threshold_desc += " \033[1;34m[Режим полного заряда]\033[0m"

    print("")
    print("\033[1;36m╭─ ThinkPad Power & Battery Monitor ─────────────────────────────╮\033[0m")
    print(f"\033[1;36m│\033[0m {icon}  \033[1mЗаряд батареи: [0m   [{bar}] \033[1m{capacity}%\033[0m ({status})")
    print(f"\033[1;36m│\033[0m ⚡ \033[1mПотребление: [0m     \033[1;33m{power_now_w:.2f} W\033[0m  \033[2m({time_str})\033[0m")
    print(f"\033[1;36m│\033[0m 🌿 \033[1mПрофиль питания: [0m \033[1;32m{platform_profile}\033[0m (Gov: {governor}, Boost: {boost_state}, GPU: {gpu_dpm})")
    print(f"\033[1;36m│\033[0m ☀️  \033[1mЯркость экрана: [0m  {bl_pct}% (снижение до ~35-40% экономит до 2 Вт)")
    print(f"\033[1;36m│\033[0m 🛡️  \033[1mПорог зарядки: [0m   {threshold_desc}")
    print(f"\033[1;36m│\033[0m 📊 \033[1mЗдоровье батареи: [0m {health_pct:.1f}% ({energy_full_wh:.2f} / {energy_design_wh:.2f} Wh, {cycles} циклов)")
    print("\033[1;36m╰────────────────────────────────────────────────────────────────╯\033[0m")
    print("\033[2mБыстрые команды: battery save | battery bal | battery perf | battery limit 80 | battery limit 100\033[0m\n")

BRI_PID_FILE = "/tmp/serpantinum_bri_fade.pid"
HOOK_STAMP_FILE = "/tmp/serpantinum_last_profile_hook"

def get_current_profile():
    p = read_val("/sys/firmware/acpi/platform_profile", "").lower().strip()
    if p:
        return "power-saver" if p in ("low-power", "power-saver") else p
    try:
        res = subprocess.run(["powerprofilesctl", "get"], capture_output=True, text=True, timeout=1)
        if res.returncode == 0:
            p_out = res.stdout.strip().lower()
            return "power-saver" if p_out in ("low-power", "power-saver") else p_out
    except Exception:
        pass
    return "balanced"

def should_skip_hook(prof):
    try:
        if os.path.exists(HOOK_STAMP_FILE):
            with open(HOOK_STAMP_FILE, "r") as f:
                data = f.read().strip().split()
                if len(data) == 2:
                    last_prof, last_time = data[0], float(data[1])
                    if last_prof == prof and (time.time() - last_time) < 1.5:
                        return True
    except Exception:
        pass
    try:
        with open(HOOK_STAMP_FILE, "w") as f:
            f.write(f"{prof} {time.time()}")
    except Exception:
        pass
    return False

def fade_brightness_worker(target_pct, duration=5.0):
    try:
        target_pct = max(1, min(100, int(target_pct)))
    except (ValueError, TypeError):
        return

    try:
        with open(BRI_PID_FILE, "w") as f:
            f.write(str(os.getpid()))
    except Exception:
        pass

    try:
        start_pct = get_brightness()
        if start_pct == target_pct:
            return

        steps = 50
        interval = max(0.02, float(duration) / float(steps))
        last_pct = start_pct

        for i in range(1, steps + 1):
            t = i / float(steps)
            ease = (1.0 - math.cos(math.pi * t)) / 2.0
            cur = int(round(start_pct + (target_pct - start_pct) * ease))
            cur = max(1, min(100, cur))
            if cur != last_pct:
                set_brightness(cur)
                last_pct = cur
            time.sleep(interval)
        set_brightness(target_pct)
    finally:
        try:
            if os.path.exists(BRI_PID_FILE):
                with open(BRI_PID_FILE, "r") as f:
                    if f.read().strip() == str(os.getpid()):
                        os.remove(BRI_PID_FILE)
        except Exception:
            pass

def start_fade_brightness_bg(target_pct, duration=5.0):
    if os.path.exists(BRI_PID_FILE):
        try:
            with open(BRI_PID_FILE, "r") as f:
                old_pid = int(f.read().strip())
            os.kill(old_pid, signal.SIGTERM)
        except Exception:
            pass

    battery_bin = shutil.which("battery") or "/usr/local/bin/battery"
    if not os.path.exists(battery_bin):
        battery_bin = os.path.realpath(__file__)
    cmd = [battery_bin, "fade-brightness", str(target_pct), str(duration)]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

def apply_profile_optimizations(prof):
    if prof in ("save", "eco", "low-power"):
        prof = "power-saver"
    elif prof in ("bal", "normal"):
        prof = "balanced"
    elif prof in ("perf", "max"):
        prof = "performance"

    # 1. Run apply-power-profile.sh via sudo -n for base deep hardware tuning (governor, boost, gpu)
    candidates = [
        "/usr/local/bin/apply-power-profile.sh",
        os.path.expanduser("~/.local/share/serpantinum/src/scripts/system/apply-power-profile.sh"),
        os.path.join(os.path.dirname(os.path.realpath(__file__)), "apply-power-profile.sh")
    ]
    for script in candidates:
        if os.path.exists(script):
            subprocess.run(["sudo", "-n", script, prof], capture_output=True)
            break

    saved = load_opts_config()

    if prof in ("balanced", "performance"):
        # Reset CPU max freq back to base/max clock
        policies = sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*"))
        if not policies:
            policies = sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq"))
        for p in policies:
            try:
                max_f = int(read_val(os.path.join(p, "cpuinfo_max_freq"), "0"))
                if max_f > 0:
                    write_val(os.path.join(p, "scaling_max_freq"), max_f)
            except Exception:
                pass

        # Revert VM laptop mode & dirty buffers & watchdog
        write_val("/proc/sys/vm/laptop_mode", "0")
        subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", "vm.laptop_mode=0"], capture_output=True)
        subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", "vm.dirty_expire_centisecs=3000"], capture_output=True)
        subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", "vm.dirty_writeback_centisecs=500"], capture_output=True)
        write_val("/proc/sys/kernel/nmi_watchdog", "1")
        subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", "kernel.nmi_watchdog=1"], capture_output=True)

        # Revert Ryzen TDP
        ryzenadj_bin = shutil.which("ryzenadj") or ("/usr/local/bin/ryzenadj" if os.path.exists("/usr/local/bin/ryzenadj") else None)
        if ryzenadj_bin:
            subprocess.run(["sudo", "-n", ryzenadj_bin, "--stapm-limit=25000", "--fast-limit=25000", "--slow-limit=20000"], capture_output=True)

        # Smoothly restore brightness if pre_saver_brightness was stored
        pre_b = saved.get("pre_saver_brightness")
        if pre_b is not None and int(pre_b) > 0:
            restore_val = int(pre_b)
            saved["pre_saver_brightness"] = 0
            save_opts_config(saved)
            start_fade_brightness_bg(restore_val, duration=5.0)

    elif prof == "power-saver":
        # 1. Smoothly fade brightness to power_saver_brightness over 5s if auto_brightness is on
        if saved.get("auto_brightness", True):
            cur_b = get_brightness()
            existing_pre = saved.get("pre_saver_brightness", 0)
            if not existing_pre or int(existing_pre) <= 0:
                saved["pre_saver_brightness"] = cur_b
                save_opts_config(saved)
            target_b = int(saved.get("power_saver_brightness", 80))
            start_fade_brightness_bg(target_b, duration=5.0)

        # 2. Apply CPU frequency limit
        cpu_mode = saved.get("cpu_freq_mode", "auto")
        target_khz = int(saved.get("cpu_max_freq", 0))
        if cpu_mode == "manual" and target_khz > 0:
            set_cpu_freq_limit(target_khz)

        # 3. Apply individual optimizations from JSON config
        for opt_id, val in saved.items():
            if opt_id not in ("cpu_max_freq", "cpu_freq_mode", "auto_brightness", "power_saver_brightness", "pre_saver_brightness"):
                apply_single_opt(opt_id, bool(val))

def set_profile(prof, set_dbus=True):
    if prof in ("save", "eco", "low-power"):
        prof = "power-saver"
    elif prof in ("bal", "normal"):
        prof = "balanced"
    elif prof in ("perf", "max"):
        prof = "performance"

    # Mark hook stamp to avoid redundant loop from Quickshell D-Bus listener
    try:
        with open(HOOK_STAMP_FILE, "w") as f:
            f.write(f"{prof} {time.time()}")
    except Exception:
        pass

    if set_dbus:
        try:
            subprocess.run(["powerprofilesctl", "set", prof], capture_output=True, text=True, timeout=2)
            time.sleep(0.2)
        except Exception:
            pass

    apply_profile_optimizations(prof)
    print(f"\033[1;32m✔ Установлен профиль энергопотребления:\033[0m \033[1m{prof}\033[0m")

def set_limit(limit_val):
    bat_dir = get_battery_dir()
    if not bat_dir:
        print("\033[1;31mБатарея не найдена.\033[0m")
        return False

    start_path = os.path.join(bat_dir, "charge_control_start_threshold")
    end_path = os.path.join(bat_dir, "charge_control_end_threshold")
    
    if not os.path.exists(end_path):
        print("\033[1;31mУправление порогом зарядки не поддерживается этим устройством.\033[0m")
        return False

    try:
        current_end = int(read_val(end_path, "100"))
    except ValueError:
        current_end = 100

    if str(limit_val).lower() in ("80", "conservation", "eco", "desk"):
        target_start = 75
        target_end = 80
        desc = "зарядка до 80% (начинается при < 75%). Продлевает срок службы батареи на годы."
    elif str(limit_val).lower() in ("100", "full", "travel"):
        target_start = 95
        target_end = 100
        desc = "зарядка до 100%. Подходит для поездок."
    else:
        try:
            val = int(limit_val)
            if 20 <= val <= 100:
                target_end = val
                target_start = max(15, val - 5)
                desc = f"зарядка до {val}% (старт при < {target_start}%)."
            else:
                print("\033[1;31mУкажите значение от 20 до 100.\033[0m")
                return False
        except ValueError:
            print("\033[1;31mНеверное значение. Примеры: battery limit 80  или  battery limit 100\033[0m")
            return False

    has_start = os.path.exists(start_path)

    # Write in safe order to avoid kernel rejecting threshold if end < start
    if has_start:
        if target_end > current_end:
            write_val(end_path, target_end)
            write_val(start_path, target_start)
        else:
            write_val(start_path, target_start)
            write_val(end_path, target_end)
    else:
        write_val(end_path, target_end)

    print(f"\033[1;32m✔ Режим защиты аккумулятора:\033[0m {desc}")
    return True

OPTS_CONFIG_PATH = os.path.expanduser("~/.config/serpantinum/power_optimizations.json")

def load_opts_config():
    defaults = {
        "cpu_boost": True,
        "wifi_powersave": True,
        "device_pm": True,
        "audio_powersave": True,
        "disk_writeback": True,
        "nmi_watchdog": True,
        "bluetooth_sleep": True,
        "cpu_max_freq": 0,
        "auto_brightness": True,
        "power_saver_brightness": 80,
    }
    if os.path.exists(OPTS_CONFIG_PATH):
        try:
            with open(OPTS_CONFIG_PATH, "r") as f:
                saved = json.load(f)
                defaults.update(saved)
        except Exception:
            pass
    return defaults

def get_brightness():
    try:
        res = subprocess.run(["serpantinum-core", "brightness", "get"], capture_output=True, text=True, timeout=1.5)
        if res.returncode == 0:
            return int(float(res.stdout.strip()))
    except Exception:
        pass
    bl_dirs = glob.glob("/sys/class/backlight/*")
    if bl_dirs:
        bl_act = read_val(f"{bl_dirs[0]}/actual_brightness", "0")
        bl_max = read_val(f"{bl_dirs[0]}/max_brightness", "65535")
        return int(float(bl_act) / float(bl_max) * 100) if bl_max and float(bl_max) > 0 else 100
    return 100

def set_brightness(pct):
    pct = max(1, min(100, int(pct)))
    try:
        res = subprocess.run(["serpantinum-core", "brightness", "set", str(pct)], capture_output=True, timeout=1.5)
        if res.returncode == 0:
            return True
    except Exception:
        pass
    bl_dirs = glob.glob("/sys/class/backlight/*")
    if bl_dirs:
        bl_max = read_val(f"{bl_dirs[0]}/max_brightness", "255")
        try:
            max_v = float(bl_max)
            target_v = int(max_v * (pct / 100.0))
            return write_val(f"{bl_dirs[0]}/brightness", target_v)
        except Exception:
            pass
    return False

def set_auto_brightness(enabled):
    saved = load_opts_config()
    saved["auto_brightness"] = bool(enabled)
    save_opts_config(saved)

    prof = get_current_profile()
    if prof in ("power-saver", "low-power"):
        if enabled:
            cur_b = get_brightness()
            if not saved.get("pre_saver_brightness"):
                saved["pre_saver_brightness"] = cur_b
                save_opts_config(saved)
            target_b = int(saved.get("power_saver_brightness", 80))
            start_fade_brightness_bg(target_b, duration=5.0)
        else:
            pre_b = saved.get("pre_saver_brightness", 0)
            if pre_b and int(pre_b) > 0:
                saved["pre_saver_brightness"] = 0
                save_opts_config(saved)
                start_fade_brightness_bg(int(pre_b), duration=5.0)
    return True

def set_saver_brightness(val):
    try:
        val = int(val)
        val = max(50, min(95, val))
    except (ValueError, TypeError):
        val = 80
    saved = load_opts_config()
    saved["power_saver_brightness"] = val
    save_opts_config(saved)

    prof = get_current_profile()
    if prof in ("power-saver", "low-power") and saved.get("auto_brightness", True):
        start_fade_brightness_bg(val, duration=5.0)
    return True

def get_cpu_freq_info():
    policies = sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*"))
    if not policies:
        policies = sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq"))
    if not policies:
        return {"supported": False, "mode": "auto", "options": [], "current_khz": 0, "current_index": 0}

    p0 = policies[0]
    base_khz = 0
    bf_path = os.path.join(p0, "base_frequency")
    if os.path.exists(bf_path):
        try:
            base_khz = int(read_val(bf_path, "0"))
        except ValueError:
            base_khz = 0

    if base_khz <= 0:
        avail_file = os.path.join(p0, "scaling_available_frequencies")
        if os.path.exists(avail_file):
            try:
                with open(avail_file, "r") as f:
                    avail = sorted(list(set(int(x) for x in f.read().split() if x.strip())))
                    if avail:
                        base_khz = max(avail)
            except Exception:
                pass

    if base_khz <= 0:
        try:
            base_khz = int(read_val(os.path.join(p0, "cpuinfo_max_freq"), "0"))
        except ValueError:
            base_khz = 0

    if base_khz <= 0:
        return {"supported": False, "mode": "auto", "options": [], "current_khz": 0, "current_index": 0}

    try:
        cur_max = int(read_val(os.path.join(p0, "scaling_max_freq"), str(base_khz)))
    except ValueError:
        cur_max = base_khz

    # Range: adaptive to hardware P-states or continuous frequency drivers
    hw_min = 0
    try:
        hw_min = int(read_val(os.path.join(p0, "cpuinfo_min_freq"), "0"))
    except ValueError:
        hw_min = 0

    min_floor = max(hw_min, 1_000_000)

    opts = []
    # 1. If driver provides discrete scaling_available_frequencies (e.g. acpi-cpufreq)
    avail_file = os.path.join(p0, "scaling_available_frequencies")
    avail = []
    if os.path.exists(avail_file):
        try:
            with open(avail_file, "r") as f:
                avail = sorted(list(set(int(x) for x in f.read().split() if x.strip())), reverse=True)
        except Exception:
            pass

    if avail:
        filtered = [f for f in avail if f <= base_khz and f >= min_floor]
        if not filtered and avail:
            filtered = [f for f in avail if f <= base_khz]
        for f in filtered:
            ghz = f / 1e6
            lbl = f"{ghz:.1f} GHz" if abs(ghz * 10 - round(ghz * 10)) < 1e-4 else f"{ghz:.2f} GHz"
            opts.append({"khz": f, "label": lbl})

    # 2. Fallback for continuous drivers (e.g. intel_pstate, amd_pstate-epp)
    if not opts:
        freq_span = base_khz - min_floor
        if freq_span <= 0:
            step = 100_000
        elif freq_span <= 600_000:
            step = 100_000
        elif freq_span <= 1_600_000:
            step = 200_000
        else:
            step = 400_000

        current = base_khz
        while current >= min_floor - 1000:
            ghz = current / 1e6
            lbl = f"{ghz:.1f} GHz" if abs(ghz * 10 - round(ghz * 10)) < 1e-4 else f"{ghz:.2f} GHz"
            opts.append({"khz": current, "label": lbl})
            if current - step < min_floor and current > min_floor:
                ghz = min_floor / 1e6
                lbl = f"{ghz:.1f} GHz" if abs(ghz * 10 - round(ghz * 10)) < 1e-4 else f"{ghz:.2f} GHz"
                opts.append({"khz": min_floor, "label": lbl})
                break
            current -= step

    saved_cfg = load_opts_config()
    saved_mode = saved_cfg.get("cpu_freq_mode", "auto")
    saved_khz = int(saved_cfg.get("cpu_max_freq", 0))

    current_index = 0
    if saved_khz > 0:
        found = False
        for idx, o in enumerate(opts):
            if o["khz"] == saved_khz:
                current_index = idx
                found = True
                break
        if not found and opts:
            current_index = min(range(len(opts)), key=lambda i: abs(opts[i]["khz"] - saved_khz))
    else:
        if cur_max < base_khz and cur_max > 0:
            for idx, o in enumerate(opts):
                if o["khz"] <= cur_max:
                    current_index = idx
                    break

    selected_khz = opts[current_index]["khz"] if opts else base_khz

    return {
        "supported": True,
        "mode": saved_mode,
        "base_khz": base_khz,
        "options": opts,
        "current_khz": selected_khz,
        "current_index": current_index
    }

def set_cpu_freq_mode(mode):
    mode = "manual" if str(mode).lower() in ("manual", "man", "1", "true") else "auto"
    saved = load_opts_config()
    saved["cpu_freq_mode"] = mode
    save_opts_config(saved)

    platform_profile = get_current_profile()
    if platform_profile in ("low-power", "power-saver"):
        policies = sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*"))
        if not policies:
            policies = sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq"))
        if mode == "auto":
            for p in policies:
                max_f = read_val(os.path.join(p, "cpuinfo_max_freq"), "")
                if max_f:
                    write_val(os.path.join(p, "scaling_max_freq"), max_f)
        else:
            target_khz = int(saved.get("cpu_max_freq", 0))
            if target_khz <= 0:
                info = get_cpu_freq_info()
                target_khz = info.get("current_khz", 0)
                saved["cpu_max_freq"] = target_khz
                save_opts_config(saved)
            if target_khz > 0:
                for p in policies:
                    write_val(os.path.join(p, "scaling_max_freq"), str(target_khz))
    return True

def set_cpu_freq_limit(target_khz):
    policies = sorted(glob.glob("/sys/devices/system/cpu/cpufreq/policy*"))
    if not policies:
        policies = sorted(glob.glob("/sys/devices/system/cpu/cpu*/cpufreq"))
    if not policies:
        return False

    try:
        target_khz = int(target_khz)
    except ValueError:
        target_khz = 0

    saved = load_opts_config()
    saved["cpu_max_freq"] = target_khz
    saved["cpu_freq_mode"] = "manual" if target_khz > 0 else "auto"
    save_opts_config(saved)

    platform_profile = get_current_profile()
    if platform_profile in ("low-power", "power-saver"):
        p0 = policies[0]
        try:
            max_freq = int(read_val(os.path.join(p0, "cpuinfo_max_freq"), "0"))
        except ValueError:
            max_freq = 0

        write_val_khz = max_freq if target_khz <= 0 else target_khz
        for p in policies:
            scaling_max = os.path.join(p, "scaling_max_freq")
            if os.path.exists(scaling_max):
                write_val(scaling_max, write_val_khz)

    return True

def save_opts_config(cfg):
    try:
        os.makedirs(os.path.dirname(OPTS_CONFIG_PATH), exist_ok=True)
        with open(OPTS_CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
    except Exception as e:
        print(f"Failed to save opts config: {e}", file=sys.stderr)

def get_hw_opt_state(opt_id, saved_val):
    if opt_id == "cpu_boost":
        # AMD boost
        v = read_val("/sys/devices/system/cpu/cpufreq/boost", "")
        if v:
            return v != "0"
        # Intel pstate no_turbo (0 = boost enabled, 1 = boost disabled)
        v_intel = read_val("/sys/devices/system/cpu/intel_pstate/no_turbo", "")
        if v_intel:
            return v_intel == "0"
        return saved_val
    elif opt_id == "wifi_powersave":
        for w in glob.glob("/sys/class/net/*/wireless"):
            dev = os.path.basename(os.path.dirname(w))
            try:
                res = subprocess.run(["iw", "dev", dev, "get", "power_save"], capture_output=True, text=True, timeout=1)
                if "power save: on" in res.stdout.lower():
                    return True
                elif "power save: off" in res.stdout.lower():
                    return False
            except Exception:
                pass
        return saved_val
    elif opt_id == "audio_powersave":
        v = read_val("/sys/module/snd_hda_intel/parameters/power_save", "")
        if v:
            return v == "1"
        return saved_val
    elif opt_id == "disk_writeback":
        v = read_val("/proc/sys/vm/dirty_writeback_centisecs", "")
        try:
            if v and int(v) >= 1500:
                return True
            elif v:
                return False
        except ValueError:
            pass
        return saved_val
    elif opt_id == "nmi_watchdog":
        v = read_val("/proc/sys/kernel/nmi_watchdog", "")
        if v:
            return v == "0"
        return saved_val
    elif opt_id == "device_pm":
        pci_ctrls = glob.glob("/sys/bus/pci/devices/*/power/control")
        if pci_ctrls:
            states = [read_val(c, "") for c in pci_ctrls[:10]]
            if "auto" in states:
                return True
            if "on" in states:
                return False
        return saved_val
    elif opt_id == "bluetooth_sleep":
        return saved_val
    return saved_val

def apply_single_opt(opt_id, enabled):
    if opt_id == "cpu_boost":
        val = "1" if enabled else "0"
        if os.path.exists("/sys/devices/system/cpu/cpufreq/boost"):
            write_val("/sys/devices/system/cpu/cpufreq/boost", val)
        for pb in glob.glob("/sys/devices/system/cpu/cpufreq/policy*/boost"):
            write_val(pb, val)
        if os.path.exists("/sys/devices/system/cpu/intel_pstate/no_turbo"):
            write_val("/sys/devices/system/cpu/intel_pstate/no_turbo", "0" if enabled else "1")
    elif opt_id == "wifi_powersave":
        mode = "on" if enabled else "off"
        for w in glob.glob("/sys/class/net/*/wireless"):
            dev = os.path.basename(os.path.dirname(w))
            res = subprocess.run(["iw", "dev", dev, "set", "power_save", mode], capture_output=True)
            if res.returncode != 0:
                subprocess.run(["sudo", "-n", "iw", "dev", dev, "set", "power_save", mode], capture_output=True)
    elif opt_id == "audio_powersave":
        val = "1" if enabled else "0"
        if os.path.exists("/sys/module/snd_hda_intel/parameters/power_save"):
            write_val("/sys/module/snd_hda_intel/parameters/power_save", val)
        if os.path.exists("/sys/module/snd_hda_intel/parameters/power_save_controller"):
            write_val("/sys/module/snd_hda_intel/parameters/power_save_controller", "Y" if enabled else "N")
    elif opt_id == "disk_writeback":
        val = "6000" if enabled else "500"
        if not write_val("/proc/sys/vm/dirty_writeback_centisecs", val):
            subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", f"vm.dirty_writeback_centisecs={val}"], capture_output=True)
    elif opt_id == "nmi_watchdog":
        val = "0" if enabled else "1"
        if not write_val("/proc/sys/kernel/nmi_watchdog", val):
            subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", f"kernel.nmi_watchdog={val}"], capture_output=True)
    elif opt_id == "device_pm":
        if enabled:
            for ctrl in glob.glob("/sys/bus/pci/devices/*/power/control"):
                pci_dir = os.path.dirname(ctrl)
                pci_class = read_val(os.path.join(pci_dir, "class"), "")
                if pci_class.startswith("0x0c03"):
                    write_val(ctrl, "on")
                    continue
                write_val(ctrl, "auto")
            for uctrl in glob.glob("/sys/bus/usb/devices/*/power/control"):
                udev_dir = os.path.dirname(uctrl)
                prod = read_val(os.path.join(udev_dir, "product"), "") + read_val(os.path.join(udev_dir, "..", "product"), "")
                vendor = read_val(os.path.join(udev_dir, "idVendor"), "") + read_val(os.path.join(udev_dir, "..", "idVendor"), "")
                if any(x in prod for x in ("Receiver", "Mouse", "Keyboard")) or vendor == "046d":
                    write_val(uctrl, "on")
                    delay_ms = os.path.join(udev_dir, "autosuspend_delay_ms")
                    if os.path.exists(delay_ms):
                        write_val(delay_ms, "-1")
                else:
                    write_val(uctrl, "auto")
        else:
            for ctrl in glob.glob("/sys/bus/pci/devices/*/power/control"):
                write_val(ctrl, "on")
            for uctrl in glob.glob("/sys/bus/usb/devices/*/power/control"):
                write_val(uctrl, "on")
    elif opt_id == "bluetooth_sleep":
        if enabled:
            try:
                res = subprocess.run(["bluetoothctl", "devices", "Connected"], capture_output=True, text=True, timeout=1)
                if not res.stdout.strip():
                    subprocess.run(["bluetoothctl", "power", "off"], capture_output=True, timeout=1)
            except Exception:
                pass
        else:
            try:
                subprocess.run(["bluetoothctl", "power", "on"], capture_output=True, timeout=1)
            except Exception:
                pass
    elif opt_id == "laptop_mode":
        val = "5" if enabled else "0"
        expire = "6000" if enabled else "3000"
        if not write_val("/proc/sys/vm/laptop_mode", val):
            subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", f"vm.laptop_mode={val}"], capture_output=True)
        if not write_val("/proc/sys/vm/dirty_expire_centisecs", expire):
            subprocess.run(["sudo", "-n", "sysctl", "-q", "-w", f"vm.dirty_expire_centisecs={expire}"], capture_output=True)
    elif opt_id == "ryzen_tdp":
        ryzenadj_bin = shutil.which("ryzenadj") or ("/usr/local/bin/ryzenadj" if os.path.exists("/usr/local/bin/ryzenadj") else None)
        if ryzenadj_bin:
            if enabled:
                subprocess.run(["sudo", "-n", ryzenadj_bin, "--stapm-limit=10000", "--fast-limit=10000", "--slow-limit=10000"], capture_output=True)
            else:
                subprocess.run(["sudo", "-n", ryzenadj_bin, "--stapm-limit=25000", "--fast-limit=25000", "--slow-limit=20000"], capture_output=True)

