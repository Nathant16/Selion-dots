// █   █▀▀█ █  █ █▀▀█ █  █ ▀▀█▀▀ █▀▀
// █   █▄▄█ █▄▄█ █  █ █  █   █   ▀▀█
// ▀▀▀ ▀  ▀ ▄▄▄█ ▀▀▀▀  ▀▀▀   ▀   ▀▀▀

hotkey-overlay {
    skip-at-startup
}

// █▀▄▀█  ▀  █▀▀ █▀▀
// █ ▀ █ ▀█▀ ▀▀█ █
// ▀   ▀ ▀▀▀ ▀▀▀ ▀▀▀

environment {
    XCURSOR_THEME "Windows-11M-Dark"
    XCURSOR_SIZE "32"
}

// Prevent direct scanout plane bypass and dynamic 8/10-bpc switches on fullscreen
debug {
    disable-direct-scanout
    keep-max-bpc-unchanged
}

