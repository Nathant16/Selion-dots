// █▀▀█ █▀▀▄  ▀  █▀▄▀█ █▀▀█ ▀▀█▀▀  ▀  █▀▀█ █▀▀▄ █▀▀
// █▄▄█ █  █ ▀█▀ █ ▀ █ █▄▄█   █   ▀█▀ █  █ █  █ ▀▀█
// ▀  ▀ ▀  ▀ ▀▀▀ ▀   ▀ ▀  ▀   ▀   ▀▀▀ ▀▀▀▀ ▀  ▀ ▀▀▀

layout {
    gaps 4
    border {
        off
    }
    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#313244"
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

include optional=true "~/.local/state/serpantinum/theme_niri.kdl"

