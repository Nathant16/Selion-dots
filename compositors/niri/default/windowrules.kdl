// █ █ █ █ █▄ █ █▀▄ █▀█ █ █ █ 　 █▀█ █ █ █   █▀▀ █▀
// ▀▄▀▄▀ █ █ ▀█ █▄▀ █▄█ ▀▄▀▄▀ 　 █▀▄ █▄█ █▄▄ ██▄ ▄█

// Picture-in-Picture
window-rule {
    match title=r#"^([Pp]icture[-\s]?[Ii]n[-\s]?[Pp]icture|[Кк]артинка в картинке)(.*)$"#
    open-floating true
}

// System dialogs & tools
window-rule {
    match app-id=r#"^(btop|pavucontrol|pwvucontrol|blueman-manager|org\.gnome\.FileRoller|gnome-calculator|qalculate-gtk|org\.gnome\.Loupe|qt5ct|qt6ct)$"#
    open-floating true
}

// Blurred wallpaper overview backdrop
layer-rule {
    match namespace="^wallpaper-overview$"
    place-within-backdrop true
}
