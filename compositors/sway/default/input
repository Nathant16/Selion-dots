input type:keyboard {
  xkb_layout "us,ru"
  xkb_options "grp:alt_shift_toggle,grp:ctrl_shift_toggle"
}

input type:touchpad {
  dwt enabled
  tap enabled
  natural_scroll enabled
  middle_emulation enabled
}

seat seat0 xcursor_theme Windows-11M-Dark 28

# Touchpad Gestures
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:left workspace next
bindgesture swipe:3:up exec serpantinum msg toggle launcher
